	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Spectre.Console.Cli" Version="0.53.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="nlog.config">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<!-- asset (sym)linking !-->
	<Import Project="..\..\src\Escape.Resources\LinkAssets.targets" />

	<ItemGroup>
		<AssetLinkProject Include="..\Escape.Editors.ResourceEditor\Escape.Editors.ResourceEditor.csproj" />
		<AssetLinkProject Include="..\..\src\Escape.Renderer\Escape.Renderer.csproj" />
		<AssetLinkProject Include="..\..\src\Escape.Extensions.Debugging\Escape.Extensions.Debugging.csproj" />
		<AssetLinkProject Include="..\..\src\Escape.Extensions.ImGui\Escape.Extensions.ImGui.csproj" />
	</ItemGroup>

	<!-- scripts !-->
	<Import Project="..\..\src\Escape.Core\Script.targets"/>

</Project>
